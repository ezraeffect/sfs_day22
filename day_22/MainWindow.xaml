<Window x:Class="day_22.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:day_22"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Resource XAML">
                <!-- Resource XAML -->
                <Image Source="/Assets/1.jpeg"/>
            </TabItem>
            <TabItem Header="Resource C#">
                <StackPanel>
                    <Image x:Name="imgTest" Width="300" Height="300"/>
                    <Button x:Name="buttonImg" Content="이미지 변경" Click="buttonImg_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Content XAML">
                <!-- Resource XAML -->
                <Image Source="/Assets/3.png"/>
            </TabItem>
            <TabItem Header="Content C#">
                <StackPanel>
                    <Image x:Name="imgTest2" Width="300" Height="300"/>
                    <Button x:Name="buttonImg2" Content="이미지 변경" Click="buttonImg2_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Pack URI C#">
                <StackPanel>
                    <Image x:Name="imgTest3" Width="300" Height="300"/>
                    <Button x:Name="buttonImg3" Content="이미지 변경" Click="buttonImg3_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>