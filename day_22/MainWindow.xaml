<Window x:Class="day_22.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:day_22"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl>
            <!-- 첫 번째 탭 아이템 -->
            <TabItem Header="학생 정보">
                <StackPanel Margin="10">
                    <TextBlock Text="학생: 홍길동"/>
                    <TextBlock Text="나이: 28"/>
                </StackPanel>
            </TabItem>

            <!-- 두 번째 탭 아이템-->
            <TabItem Header="Grid">
                <Grid>
                    <!-- 행과 열 정보 미리 선언 -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Content -->
                    <!-- Grid.Row : 해당 요소가 위치할 행 번호 (0부터 시작) -->
                    <!-- Grid.Column : 해당 요소가 위치할 열 번호 (0부터 시작) -->

                    <!-- 0행 0열 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="이름" Margin="5"/>

                    <!-- 0행 1열 -->
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="5"/>

                    <!-- 1행 0열부터 1열까지 합침 -->
                    <!-- Grid.RawSpan : 여러 행에 걸쳐 배치할 떄 (행 삽입) -->
                    <!-- Grid.ColumnSpan : 여러 열에 걸쳐 배치할 때 (열 삽입) -->
                    <Button Grid.Row="1" Grid.ColumnSpan="2" Content="확인" Margin="5"/>

                </Grid>
            </TabItem>

            <TabItem Header="GroupBox">
                <GroupBox Header="사용자 정보" Margin="10">
                    <StackPanel Margin="10">
                        <TextBlock Text="이름: "/>
                        <TextBox Width="200"/>

                        <TextBlock Text="나이: "/>
                        <TextBox Width="200"/>

                        <TextBlock Text="성별을 선택하세요: " FontSize="14" Margin="0,0,0,10"/>
                        <RadioButton x:Name="radioMale" Content="남성" GroupName="gender" IsChecked="True" Margin="0,0,0,15"/>
                        <RadioButton x:Name="radioFemale" Content="여성" GroupName="gender" Margin="0,0,0,15"/>

                        <!--  Checked = "radioMale_Checked" 처럼 이벤트 = 메서드명 으로 이벤트 헨들러와 직접 연결도 가능하다 -->

                        <Button Content="확인" Click="Button_Click"/>
                    </StackPanel>
                </GroupBox>
            </TabItem>

            <TabItem Header="Slider">
                <StackPanel Margin="20">
                    <TextBlock Text="볼륨 조절: " FontSize="14" Margin="0,0,0,10"/>
                    <Slider Minimum="0" Maximum="100" Value="50"/>
                    <Slider Minimum="0" Maximum="100" TickFrequency="20" IsSnapToTickEnabled="True"/>
                    <StackPanel Margin="20">
                        <Slider x:Name="volumeSlider" Minimum="0" Maximum="100" Value="40" TickFrequency="10" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Width="200" ValueChanged="volumeSlider_ValueChanged"/>
                        <TextBlock x:Name="volumeText" FontSize="20" Margin="10" Text="현재 값"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="CheckBox">
                <StackPanel Margin="20">
                    <CheckBox x:Name="checkboxApple" Content="사과" Checked="checkbox_Checked" Unchecked="checkbox_Checked"/>
                    <CheckBox x:Name="checkboxBanana" Content="바나나" Checked="checkbox_Checked" Unchecked="checkbox_Checked"/>
                    <CheckBox x:Name="checkboxOrange" Content="오렌지" Checked="checkbox_Checked" Unchecked="checkbox_Checked"/>
                    <TextBlock x:Name="textResult" FontSize="20" Margin="10"/>

                    <CheckBox x:Name="checkboxState" Content="중간 상태 체크박스" IsThreeState="True" Click="checkboxState_Click"/>
                    <TextBlock x:Name="textState" FontSize="26" Margin="10"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="ComboBox">
                <StackPanel Margin="20">
                    <TextBlock Text="Select Fruits: " FontSize="26" Margin="0,0,0,5" />
                    <ComboBox x:Name="comboFruits" Width="200" Height="100" SelectionChanged="comboFruits_SelectionChanged">
                        <ComboBoxItem Content="Apple" />
                        <ComboBoxItem Content="Banana" />
                        <ComboBoxItem Content="Orange" />
                    </ComboBox>
                    <TextBlock x:Name="textResult2" FontSize="26" Margin="10" />
                </StackPanel>
            </TabItem>

            <TabItem Header="ListBox">
                <StackPanel Margin="20">
                    <TextBlock Text="좋아하는 색상을 선택하세요." FontSize="26" Margin="0,0,0,5"/>
                    <ListBox x:Name="listColors" Height="100" Width="200" SelectionChanged="listColors_SelectionChanged">
                        <ListBoxItem Content="빨강"/>
                        <ListBoxItem Content="초록"/>
                        <ListBoxItem Content="파랑"/>
                    </ListBox>
                    <TextBlock x:Name="textResult3" FontSize="26" Margin="20"/>
                    <ListBox x:Name="listFruits" SelectionMode="Multiple" SelectionChanged="listFruits_SelectionChanged">
                        <ListBoxItem Content="사과"/>
                        <ListBoxItem Content="바나나"/>
                        <ListBoxItem Content="오렌지"/>
                        <ListBoxItem Content="포도"/>
                    </ListBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Data Binding">
                <ListBox x:Name="listBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Web">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <WebBrowser x:Name="WebBrowser1"/>
                    <Button x:Name="buttonNaver" Content="네이버로 이동" Width="100" Margin="0,0,10,0" Click="buttonNaver_Click"/>
                    <Button x:Name="buttonForward" Content="앞으로 이동" Width="100" Margin="0,0,10,0" Click="buttonForward_Click"/>
                    <Button x:Name="buttonBack" Content="뒤로 이동" Width="100" Margin="0,0,10,0" Click="buttonBack_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>